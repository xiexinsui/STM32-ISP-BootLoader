{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ISP_Downloader_C (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/ISP_Downloader_C.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/Qt/Tools/mingw1310_64/bin/gdb.exe",
