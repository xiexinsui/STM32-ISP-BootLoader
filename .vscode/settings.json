{
    // CMake Tools 插件（若安装）复用同一套工具链；未安装也不影响 Ctrl+Shift+B 构建
    "cmake.cmakePath": "D:/Qt/Tools/CMake_64/bin/cmake.exe",
    "cmake.generator": "Ninja",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.configureSettings": {
        "CMAKE_C_COMPILER": "D:/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_MAKE_PROGRAM": "D:/Qt/Tools/Ninja/ninja.exe"
    },
    "cmake.configureOnOpen": false,
    "C_Cpp.default.compilerPath": "D:/Qt/Tools/mingw1310_64/bin/gcc.exe",
    "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
    "files.associations": {
        "*.rc": "rc"
    },
    "files.encoding": "utf8",
    "files.watcherExclude": {
        "**/build/**": true,
        "**/build-debug/**": true,
        "**/dist/**": true
    },
    "search.exclude": {
        "**/build": true,
        "**/build-debug": true,
        "**/dist": true
    },
    "editor.formatOnSave": false
}
